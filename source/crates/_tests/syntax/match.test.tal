///
/// @testing Syntax "match" Declaration.
/// @describe Coordinates testing the builtin "match" declaration.
///

// Talos Modules
import "talos:test" as Test;
import "talos:assert" as Assert;

// - TEST CASES - //

Test.suite("Syntax", fn {
    Test.case("Match 'Number'", fn {
        // prepare an expected value to be used
        let value = 42;

        // do a simple check that our value passes
        match (value) {
            42: Void,
            10: Assert.fail("Expected {0}".fmt(value)),
            *: Assert.fail("Expected non-defaulted value"),
        }

        // check that the default does not come first
        match (42) {
            *: Assert.fail("Expected non-defaulted value"),
            10: Assert.fail("Expected {0}".fmt(value)),
            42: Void,
        }
    });
});
